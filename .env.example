# Edicion del stack.txt (gedit). Copia a .env y rellena.
# Contraseña de edicion
EDIT_PASSWORD=
# Secreto para firmar los tokens de sesion (openssl rand -hex 32)
EDIT_SESSION_SECRET=
# Alternativa: SHA-256 (hex) de la contraseña en vez del texto plano
# printf "%s" "tu-pass" | shasum -a 256
EDIT_PASSWORD_SHA256=
# GitHub (PAT con Contents: Read and write) para guardar en el repo
GITHUB_TOKEN=
GITHUB_REPO=readmin803/readmin803
GITHUB_BRANCH=main
GITHUB_STACK_PATH=data/stack.txt
